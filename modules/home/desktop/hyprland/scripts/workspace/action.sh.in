#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$SCRIPT_DIR/common.sh"

ACTION=$1
TARGET_NUM=$2

CUR=$(@hyprctl@ activeworkspace -j | @jq@ -r '.name')

if [[ "$CUR" =~ ^(.+)-([0-9]+)$ ]]; then
    PREFIX="${BASH_REMATCH[1]}"
    TARGET_NAME="${PREFIX}-${TARGET_NUM}"
    IS_NAMED=true
else
    TARGET_NAME="$TARGET_NUM"
    IS_NAMED=false
fi

case $ACTION in
    switch)
        summon_workspace_to_focused_monitor \
            "$([ "$IS_NAMED" = true ] && printf 'named' || printf 'default')" \
            "$TARGET_NAME"

        if [ "$IS_NAMED" = true ]; then
            @hyprctl@ eval "hl.dispatch(hl.dsp.focus({ workspace = \"name:$TARGET_NAME\" }))"
        else
            @hyprctl@ eval "hl.dispatch(hl.dsp.focus({ workspace = \"$TARGET_NAME\" }))"
        fi
        ;;
    move)
        if [ "$IS_NAMED" = true ]; then
            @hyprctl@ eval "hl.dispatch(hl.dsp.window.move({ workspace = \"name:$TARGET_NAME\" }))"
        else
            @hyprctl@ eval "hl.dispatch(hl.dsp.window.move({ workspace = \"$TARGET_NAME\" }))"
        fi
        ;;
esac
